Django==6.1.1
psycopg[binary]==3.3.6
# Federated customer sign-in (M004 - ADR-0002 "Authentication"). The
# [socialaccount] extra pulls in requests/oauthlib/pyjwt[crypto], which
# allauth's OAuth2 provider machinery (google/microsoft) depends on for the
# token exchange/profile fetch - see identity/adapters.py and
# config/settings.py's SOCIALACCOUNT_PROVIDERS block.
django-allauth[socialaccount]==65.19.6
# Approved-policy PDF rendering (M004 PID §19, m004-2b-policy-lifecycle
# dispatch). Pure-Python, high-level platypus flowable API - no
# system-level Cairo/Pango dependency to add to the Dockerfile (unlike
# WeasyPrint), keeping this within the build-reproducibility discipline in
# docs/delivery/BUILD-REPRODUCIBILITY.md. See policy/pdf.py.
reportlab==5.0.1
# Serves collected static assets directly from the application process
# under DEBUG=False (M006 Round 6, PID §15/§C - the DEBUG=False
# static-file gap Round 2 identified and deliberately deferred). Chosen
# over a new production web-server/reverse-proxy architecture (explicitly
# out of scope, PID §15) or `runserver --insecure` (Django's own docs
# call this "grossly inefficient and probably insecure" for anything
# beyond local throwaway use): pure WSGI middleware, works unmodified
# with the existing `manage.py runserver` command, no new deployment
# topology. See config/settings.py's WHITENOISE_* block and
# docs/evidence/M006-RELEASE.md for the full reasoning.
whitenoise==6.11.0
# M009A (WO-M009A-SECURE-INGESTION-XLSX.md, Final Correction C - "the
# earlier claim that openpyxl is the only dependency this Work Order
# introduces is withdrawn, it is false"). XLSX parser for secure
# questionnaire artifact ingestion - load mode mandated by the Work Order:
# `read_only=True, data_only=False` (questionnaire/xlsx_extraction.py).
# MIT licensed.
openpyxl==3.1.5
# M009A - XML hardening required before any attacker-controlled OOXML XML
# part reaches openpyxl's parser (questionnaire/security_gate.py). PSF
# licensed.
defusedxml==0.7.1
# WSGI application server for the persistent release deployment
# (PID-DBR-001 / docs/work-orders/WO-DEPLOYMENT-BOUNDARY-REMEDIATION.md
# Sec1.5, C5 - "the minimum release-packaging change needed to add one
# pinned, reproducible WSGI/ASGI server dependency - nothing else in the
# dependency set"). gunicorn, not uvicorn: this codebase has no
# config/asgi.py and no async/websocket view anywhere - config/wsgi.py is
# the only application entrypoint module, so this is a purely synchronous
# WSGI app and a WSGI-only server is sufficient; uvicorn exists to add
# ASGI/async support this code does not use, so adding it too would be
# an unauthorised extra dependency, not "the minimum" change. Invoked
# only by docker-compose.release.yml's web.command and scripts/release.sh
# - never by the normal dev stack (docker-compose.yml keeps
# manage.py runserver, unchanged, out of scope) or by the Dockerfile's own
# default CMD (also unchanged - see scripts/release.sh header comment for
# why the release command lives in docker-compose.release.yml, not here).
gunicorn==26.2.0
