Django==6.1.1
psycopg[binary]==3.3.6
# Federated customer sign-in (M004 - ADR-0002 "Authentication"). The
# [socialaccount] extra pulls in requests/oauthlib/pyjwt[crypto], which
# allauth's OAuth2 provider machinery (google/microsoft) depends on for the
# token exchange/profile fetch - see identity/adapters.py and
# config/settings.py's SOCIALACCOUNT_PROVIDERS block.
django-allauth[socialaccount]==65.19.4
# Approved-policy PDF rendering (M004 PID §19, m004-2b-policy-lifecycle
# dispatch). Pure-Python, high-level platypus flowable API - no
# system-level Cairo/Pango dependency to add to the Dockerfile (unlike
# WeasyPrint), keeping this within the build-reproducibility discipline in
# docs/delivery/BUILD-REPRODUCIBILITY.md. See policy/pdf.py.
reportlab==5.0.1
# Serves collected static assets directly from the application process
# under DEBUG=False (M006 Round 6, PID §15/§C - the DEBUG=False
# static-file gap Round 2 identified and deliberately deferred). Chosen
# over a new production web-server/reverse-proxy architecture (explicitly
# out of scope, PID §15) or `runserver --insecure` (Django's own docs
# call this "grossly inefficient and probably insecure" for anything
# beyond local throwaway use): pure WSGI middleware, works unmodified
# with the existing `manage.py runserver` command, no new deployment
# topology. See config/settings.py's WHITENOISE_* block and
# docs/evidence/M006-RELEASE.md for the full reasoning.
whitenoise==6.11.0
