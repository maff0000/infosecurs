# Copy this file to .env and fill in real local values.
# .env is gitignored - never commit real secrets.
#
# Every value here is a placeholder. Missing required configuration causes
# Django to fail loudly at startup rather than silently default
# (see config/env.py).

# --- Django ---
# One of: development | test | production
DJANGO_ENV=development
# Generate a real value locally, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-real-locally-generated-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional, comma-separated. Only needed behind HTTPS/a reverse proxy.
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database ---
POSTGRES_DB=infosecurs
POSTGRES_USER=infosecurs
POSTGRES_PASSWORD=replace-with-a-real-local-dev-password
# POSTGRES_HOST / POSTGRES_PORT are set by docker-compose.yml for the web
# service; only needed here if you run manage.py outside Docker.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Host port mappings (optional overrides)
POSTGRES_HOST_PORT=5432
WEB_HOST_PORT=8000

# --- Customer Zero bootstrap (organisations.management.commands.create_customer_zero) ---
# Synthetic/local only - never real customer credentials.
CUSTOMER_ZERO_USERNAME=customerzero
CUSTOMER_ZERO_EMAIL=customerzero@example.test
CUSTOMER_ZERO_PASSWORD=replace-with-a-real-local-dev-password-12+chars
CUSTOMER_ZERO_ORGANISATION_NAME=Infosecurs Limited

# --- AI gateway (M002 - ai_platform app) ---
# Read LAZILY by ai_platform.gateway.LiteLLMGateway, only when a risk
# generation is actually invoked - not at Django startup. Every other
# feature (profile, baseline, assets, etc.) works in dev/CI without these
# set (PID docs/pids/M002-SECURITY-BASELINE-AND-INITIAL-RISK.md §9.2, §14).
#
# Base URL of the existing, already-governed Trinity LiteLLM-compatible
# gateway. No project-specific gateway/alias is deployed for Infosecurs.
AI_GATEWAY_BASE_URL=
# Path to a file containing the bearer credential for that gateway - this
# is a FILE PATH, never the credential value itself. Never put a real key
# directly in this file or commit one anywhere in this repository.
AI_GATEWAY_API_KEY_FILE=
# Governed, generic logical model alias (not Infosecurs-specific).
# Defaults to trinity-core if unset.
AI_RISK_MODEL_ALIAS=trinity-core
